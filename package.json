{
  "name": "openclaw-portal",
  "version": "1.0.0",
  "description": "Cogna8 OpenClaw self-service portal",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma && prisma generate --schema=prisma-service/schema.prisma",
    "prisma:migrate-deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "build": "npm run prisma:generate && npm run prisma:migrate-deploy && next build",
    "start": "next start",
    "typecheck": "npm run prisma:generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma"
    ]
  },
  "dependencies": {
    "@cogna8/ui": "1.0.1",
    "@mdx-js/loader": "^3.0.0",
    "@mdx-js/react": "^3.0.0",
    "@neondatabase/serverless": "^1.0.0",
    "@next/mdx": "^15.0.0",
    "@phosphor-icons/react": "^2.1.0",
    "@prisma/adapter-neon": "^6.19.0",
    "@prisma/client": "^6.19.0",
    "@tailwindcss/postcss": "^4.2.4",
    "clsx": "^2.0.0",
    "geist": "^1.0.0",
    "nanoid": "^3.3.0",
    "next": "^15.0.0",
    "next-auth": "5.0.0-beta.25",
    "next-themes": "^0.4.6",
    "radix-ui": "1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/mdx": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.0.0",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
