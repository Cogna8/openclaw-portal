generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("CG8_PORTAL_DATABASE_URL")
}

enum portal_role_t {
  user
  admin
  super_admin
}

model PortalUser {
  id                String        @id @default(uuid()) @db.Uuid
  email             String        @unique
  name              String?
  image             String?
  role              portal_role_t @default(user)
  googleId          String        @unique @map("google_id")
  openclawAccountId String?       @map("openclaw_account_id")
  isBlocked         Boolean       @default(false) @map("is_blocked")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  lastLoginAt       DateTime?     @map("last_login_at") @db.Timestamptz
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz

  @@map("portal_users")
}

enum admin_audit_action_t {
  user_block
  user_unblock
  user_role_promote
  user_role_demote
  account_plan_change
  account_limits_change
  account_status_change
}

enum admin_audit_target_t {
  portal_user
  openclaw_account
}

model AdminAuditLog {
  id                String               @id @default(uuid()) @db.Uuid
  actorPortalUserId String               @map("actor_portal_user_id") @db.Uuid
  actorEmail        String               @map("actor_email")
  action            admin_audit_action_t
  targetType        admin_audit_target_t @map("target_type")
  targetId          String               @map("target_id")
  targetLabel       String?              @map("target_label")
  before            Json?
  after             Json?
  metadata          Json?
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt])
  @@index([actorPortalUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}
